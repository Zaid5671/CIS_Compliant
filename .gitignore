# ---- Python ----
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/
.pytest_cache/
.ruff_cache/

# ---- Virtual environments ----
.venv/
venv/
env/

# ---- OmniBench runtime output ----

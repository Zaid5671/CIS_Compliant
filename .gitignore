# evidence from the audited machine. Never commit them.
reports/
*.token
session.token
history.jsonl
omnibench.ini

# ---- Logs / process files ----
*.log
*.pid

# ---- Local tooling, editor, and agent config ----
.claude/
.idea/
.vscode/
*.code-workspace

# ---- OS cruft ----
.DS_Store
Thumbs.db
